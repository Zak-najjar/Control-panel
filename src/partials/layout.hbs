      <div>
        <span class="c-help__text">
          تعلم المزيد حول
        </span>
        <a href="./products.html" class="c-help__link">المنتجات</a>
      </div>
    </div>

  </div>
  <script type="module" src="./src/main.js"></script>
  <script type="module" src="./src/scripts/sidebar.js"></script>

  {{#if pageScript}}
  <script type="module" src={{pageScript}}></script>
  {{/if}}
</body>

</html>